# Next.js frontend proxies /api/* requests to this PHP service.
PHP_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000/api"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# PHP/MySQL service configuration.
DB_HOST="127.0.0.1"
DB_NAME="tpk_attendance_system"
DB_USER="root"
DB_PASSWORD=""
FRONTEND_ORIGIN="http://localhost:3000"
TPK_FRONTEND_URL="http://localhost:3000"

# Use development only on a local machine. Without a WhatsApp provider, verification
# links are written to backend/storage/whatsapp-verifications.log in this mode.
APP_ENV="development"
# WHATSAPP_VERIFICATION_WEBHOOK="https://your-provider.example/send"
# SMS_PICKUP_WEBHOOK="https://your-sms-provider.example/send"
# WHATSAPP_PICKUP_WEBHOOK="https://your-whatsapp-provider.example/send"
